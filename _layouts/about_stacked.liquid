---
layout: default
---

<div class="profile-page-shell home-profile-page home-profile-page--stacked">
  {% include profile_sidebar.liquid %}

  <main class="profile-page-main home-main">
    <section class="home-hero" style="--hero-bg-image: url('{{ 'assets/img/research-banner-manifold-native-9x1.png' | relative_url }}');" aria-labelledby="home-hero-title">
      <div class="home-hero__copy">
        <h1 id="home-hero-title">Representation Learning for Trustworthy AI</h1>
        <p>Advancing trustworthy AI through principled representation learning.</p>
      </div>
    </section>

    <div class="home-stacked-sections">
      <section class="home-about">
        {{ content }}
      </section>

      {% if page.news and site.announcements.enabled %}
        <section class="home-section home-news">
          <h2>
            <span class="home-section__icon">🔥</span>
            <span>Latest News</span>
            <a class="home-news__all-link" href="{{ '/news/' | relative_url }}">View all news <span aria-hidden="true">→</span></a>
          </h2>
          <div class="home-news__body">
            {% assign news = site.news | reverse %}
            <ul>
              {% for item in news limit: 13 %}
                <li>
                  {% assign news_text = item.content | strip_html | downcase %}
                  <em>{{ item.date | date: '%Y.%m' }}</em>:
                  {% if news_text contains 'accepted' or news_text contains 'accepté' or news_text contains 'accepte' %}
                    <span class="home-news__celebration">🎉🎉</span>
                  {% endif %}
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </section>
      {% endif %}

      {% if page.selected_papers %}
        <section class="home-section home-publications">
          <h2>
            <a href="{{ '/publications/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.selected_publications }}</a>
          </h2>
          {% include selected_papers.liquid %}
        </section>
      {% endif %}
    </div>

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </main>
</div>
