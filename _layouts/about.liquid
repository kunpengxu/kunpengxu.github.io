---
layout: default
---
<div class="home-profile-page">
  {% include profile_sidebar.liquid %}

  <main class="home-main">
    <section class="home-about">
      {{ content }}
    </section>

    {% if page.news and site.announcements.enabled %}
      <section class="home-section home-news">
        <h2>
          <span class="home-section__icon">🔥</span>
          <span>{{ site.data[site.active_lang].strings.news | default: 'news' | capitalize }}</span>
        </h2>
        {% assign news = site.news | reverse %}
        {% if site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = site.news | size %}
        {% endif %}
        <ul>
          {% for item in news limit: news_limit %}
            <li>
              {% assign news_text = item.content | strip_html | downcase %}
              <em>{{ item.date | date: '%Y.%m' }}</em>:
              {% if news_text contains 'accepted' or news_text contains 'accepté' or news_text contains 'accepte' %}
                <span class="home-news__celebration">🎉🎉</span>
              {% endif %}
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section home-publications">
        <h2>
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.selected_publications }}</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </main>
</div>
